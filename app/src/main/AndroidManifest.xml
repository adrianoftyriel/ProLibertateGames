<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OTA updates from GitHub Releases, plus LAN play over TCP sockets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Network Service Discovery needs multicast to see hosts on the LAN. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Holding a Wi-Fi lock keeps the radio out of power save while a game is
         on, so a phone locked between turns does not drop out of it. The lock
         is a wake lock as far as the system is concerned, hence the permission;
         nothing here ever holds the screen or the CPU awake. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the app hand a downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The radio is optional: the app is fully playable against AI without it. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProLibertateGames">

        <!-- No fixed orientation: the UI adapts to portrait, landscape and
             tablet widths. configChanges keeps Compose state across rotation
             instead of tearing the activity down mid-hand.

             adjustResize is stated rather than left to the system to resolve:
             the scorekeeper types into the bottom row of its sheet, and the
             totals and the button that finishes the round sit below that. The
             window has to shrink so they stay above the keyboard rather than
             being panned off the screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the downloaded APK to the package installer via a content URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
