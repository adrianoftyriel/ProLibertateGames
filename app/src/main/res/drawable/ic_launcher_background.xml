<?xml version="1.0" encoding="utf-8"?>
<!--
  A single square of the Wallace tartan.

  The sett is laid down as warp (opaque, vertical) over a black ground, then as
  weft (half opacity, horizontal), which is what produces the blended squares
  rather than a flat grid. One full repeat is 72 units wide, so the centre
  72x72 safe zone of the adaptive icon shows exactly one repeat.

  Thread proportions match WallaceSett in Tartan.kt — see the note there about
  these being a visual approximation rather than the registered threadcount.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ground -->
    <path
        android:fillColor="#111111"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Warp: red -->
    <path
        android:fillColor="#B3121B"
        android:pathData="M0,0h34.29v108h-34.29z" />
    <path
        android:fillColor="#B3121B"
        android:pathData="M72,0h34.29v108h-34.29z" />
    <!-- Warp: gold overstripe -->
    <path
        android:fillColor="#F2C200"
        android:pathData="M68.57,0h3.43v108h-3.43z" />

    <!-- Weft: red -->
    <path
        android:fillColor="#B3121B"
        android:fillAlpha="0.5"
        android:pathData="M0,0h108v34.29h-108z" />
    <path
        android:fillColor="#B3121B"
        android:fillAlpha="0.5"
        android:pathData="M0,72h108v34.29h-108z" />
    <!-- Weft: black -->
    <path
        android:fillColor="#111111"
        android:fillAlpha="0.5"
        android:pathData="M0,34.29h108v34.28h-108z" />
    <path
        android:fillColor="#111111"
        android:fillAlpha="0.5"
        android:pathData="M0,106.29h108v1.71h-108z" />
    <!-- Weft: gold overstripe -->
    <path
        android:fillColor="#F2C200"
        android:fillAlpha="0.5"
        android:pathData="M0,68.57h108v3.43h-108z" />
</vector>
