<?xml version="1.0" encoding="utf-8"?>
<!--
  The colours the sett shares between channels. The one that differs —
  tartan_field, red on production and hunting green on dev — is generated by the
  build, along with splash_background and ic_launcher_background, which are
  shades of it. See resValue in app/build.gradle.kts.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- The ground the sett is woven on, and the overstripe down its centre.
         Same numbers as WallaceBlack and WallaceGold in Tartan.kt. -->
    <color name="tartan_ground">#0C0C0C</color>
    <color name="tartan_over">#F2C518</color>
</resources>
