<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback launcher icon for API < 26, which has no adaptive-icon support.
     Same Wallace tartan swatch as drawable/ic_launcher_background.xml, drawn
     at icon scale so one full sett repeat fills the tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="84"
    android:viewportHeight="84">

    <path android:fillColor="#111111" android:pathData="M0,0h84v84h-84z" />

    <!-- Warp -->
    <path android:fillColor="#B3121B" android:pathData="M0,0h40v84h-40z" />
    <path android:fillColor="#F2C200" android:pathData="M80,0h4v84h-4z" />

    <!-- Weft -->
    <path android:fillColor="#B3121B" android:fillAlpha="0.5" android:pathData="M0,0h84v40h-84z" />
    <path android:fillColor="#111111" android:fillAlpha="0.5" android:pathData="M0,40h84v40h-84z" />
    <path android:fillColor="#F2C200" android:fillAlpha="0.5" android:pathData="M0,80h84v4h-84z" />
</vector>
